# Monarch Money credentials
MONARCH_EMAIL=your@email.com
MONARCH_PASSWORD=your-password
MONARCH_MFA_SECRET=your-totp-secret

# Google Sheets target
EXPENSE_SHEET_ID=your-google-spreadsheet-id

# Google OAuth file locations (optional).
# Leave unset and Cashew looks in ./.secrets/ then one level above the repo.
# nagelia-dev-setup's `./install.sh cashew` writes GOOGLE_CREDENTIALS_FILE here.
# GOOGLE_CREDENTIALS_FILE=/abs/path/to/google-credentials.json
# GOOGLE_TOKEN_FILE=/abs/path/to/google-token.json   # defaults next to the creds file

# macOS Python 3.12 SSL fix (uncomment and update path)
# SSL_CERT_FILE=/path/to/lib/python3.12/site-packages/certifi/cacert.pem
